# Configuration environnement canonique du Discord Bot Refuge.
#
# - Les valeurs non sensibles ci-dessous correspondent aux valeurs par défaut
#   actuellement utilisées par le code.
# - Les secrets restent volontairement vides : ne jamais committer une vraie clé.
# - Sur Railway, créez/éditez ces clés dans l'onglet Variables du service.
# - Une valeur vide n'est PAS équivalente à une variable absente pour les
#   paramètres numériques validés : conservez les valeurs numériques proposées.

# ── Discord / processus ───────────────────────────────────────────────
# SECRET — obligatoire au démarrage.
DISCORD_TOKEN=
# 0 = synchronisation globale des commandes ; sinon Snowflake du serveur cible.
GUILD_ID=0
OWNER_ID=541417878314942495
TZ=Europe/Paris

# ── Persistance ──────────────────────────────────────────────────────
# Railway utilise /app/data automatiquement si DATA_DIR est absent et que ce
# montage existe. /data reste le fallback historique explicite de cet exemple.
DATA_DIR=/data
GAMES_DATA_DIR=/data/games
# 300 s = 5 min. Ne pas réduire sans accepter davantage d'écritures disque.
VOICE_CP_DEBOUNCE_SECONDS=300

# ── Salons, rôles et alertes Discord configurables ──────────────────
# 0 = option désactivée/fallback lorsque le code l'autorise.
TRIGGER_CHANNEL_ID=0
ECONOMY_CHANNEL_ID=1409633293791400108
F1_CHANNEL_ID=0
VIP_24H_ROLE_ID=0
ANNOUNCE_CHANNEL_ID=1400552164979507263
AWARD_ANNOUNCE_CHANNEL_ID=1400552164979507263
ENABLE_DAILY_AWARDS=1
LEVEL_FEED_CHANNEL_ID=1402419913716531352
ENABLE_GAME_LEVEL_FEED=1
TIKTOK_ANNOUNCE_CH=1400552164979507263
ACTIVITY_SUMMARY_CH=1400552164979507263
REMINDER_CHANNEL_ID=1400552164979507263
BOT_ALERTS_CHANNEL_ID=0
# Notification CRITICAL secondaire uniquement. 0 = désactivée. Les crashes et
# anomalies process doivent rester surveillés hors du bot (Railway/Sentry/APM).
CRITICAL_LOG_CHANNEL_ID=0

# ── Salons vocaux temporaires / Streamer ────────────────────────────
# TEMP_VOICE_CATEGORY_ID=0 => utiliser la catégorie du salon déclencheur.
TEMP_VOICE_CATEGORY_ID=0
DELETE_DELAY_SECONDS=45

# ── Casino / roulette XP ────────────────────────────────────────────
CASINO_OPEN_HOUR=10
CASINO_CLOSE_HOUR=6
MACHINE_A_SOUS_BOUNDARY_CHECK_INTERVAL_MINUTES=1
PARI_XP_ROLE_ID=0
PARI_XP_MIN_BET=10
PARI_XP_MAX_BET=500

# Progression du bâtiment Casino du Refuge. Listes CSV strictement croissantes.
# Valeurs vides = seuils non calibrés ; poids à 0 = progression désactivée.
REFUGE_CASINO_LEVEL_THRESHOLDS_POINTS=
REFUGE_CASINO_ROULETTE_BET_WEIGHT=0
REFUGE_CASINO_ROULETTE_PLAYER_WEIGHT=0
REFUGE_CASINO_JACKPOT_500_WEIGHT=0
REFUGE_CASINO_JACKPOT_1000_WEIGHT=0
REFUGE_CASINO_FORTUNE_THRESHOLDS_XP=

# ── Radio ────────────────────────────────────────────────────────────
RADIO_STREAM_URL=https://stream.laut.fm/hiphop-forever
RADIO_RAP_FR_STREAM_URL=https://icecast.skyrock.net/s/francais_aac_96k
ROCK_RADIO_STREAM_URL=https://stream.laut.fm/rockworld

# ── Renommage de salons / intervalles Discord ───────────────────────
CHANNEL_RENAME_MIN_INTERVAL_PER_CHANNEL=5
CHANNEL_RENAME_MIN_INTERVAL_GLOBAL=2
CHANNEL_RENAME_DEBOUNCE_SECONDS=2
CHANNEL_RENAME_MAX_RETRIES=5
CHANNEL_RENAME_BACKOFF_BASE=2.0

# ── Double XP vocal ─────────────────────────────────────────────────
XP_DOUBLE_VOICE_DURATION_MINUTES=60
XP_DOUBLE_VOICE_START_HOUR=10
XP_DOUBLE_VOICE_END_HOUR=23
XP_DOUBLE_VOICE_ANNOUNCE_CHANNEL_ID=1400552164979507263

# ── Rate limiter Discord ────────────────────────────────────────────
RATE_LIMIT_STRICT=true
GLOBAL_RPS=50

# ── API meter / observabilité ──────────────────────────────────────
API_BUDGET_PER_10MIN=10000
API_SOFT_LIMIT_PCT=85
API_HARD_LIMIT_PCT=95
API_SLOW_CALL_MS=1000
API_REPORT_INTERVAL_MIN=1
API_METER_PERSIST_INTERVAL_SECONDS=30

# ── Maître du jeu — Mistral ────────────────────────────────────────
# SECRET — optionnel. Vide => fallback IA indisponible, sans casser le bot.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-3-5
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_TIMEOUT_SECONDS=10.0
MISTRAL_MAX_OUTPUT_TOKENS=500
MISTRAL_MEMORY_TTL_SECONDS=600.0
MISTRAL_MEMORY_MAX_MESSAGES=6
MISTRAL_USER_COOLDOWN_SECONDS=8.0
MISTRAL_USER_WINDOW_SECONDS=3600.0
MISTRAL_MAX_REQUESTS_PER_WINDOW=20
# Plafond partagé par tous les membres : 100 appels sur une fenêtre d'une heure.
MISTRAL_GLOBAL_WINDOW_SECONDS=3600.0
MISTRAL_GLOBAL_MAX_REQUESTS_PER_WINDOW=100
MISTRAL_QUESTION_MAX_CHARS=1200
MISTRAL_RESPONSE_MAX_CHARS=3500
MISTRAL_MAX_CONCURRENCY=2

# ── Refuge — panneau et journal ─────────────────────────────────────
# REFUGE_PANEL_CHANNEL_ID=0 désactive le panneau public.
REFUGE_PANEL_CHANNEL_ID=1536027732071161987
REFUGE_PANEL_REFRESH_SECONDS=60
REFUGE_JOURNAL_CHANNEL_ID=1400552164979507263

# ── Refuge — objectifs automatiques / construction ─────────────────
REFUGE_AUTO_GOAL_COOLDOWN_MIN_HOURS=12
REFUGE_AUTO_GOAL_COOLDOWN_MAX_HOURS=36
REFUGE_AUTO_GOAL_DURATION_MIN_DAYS=2
REFUGE_AUTO_GOAL_DURATION_MAX_DAYS=5
REFUGE_AUTO_GOAL_MIN_OBSERVATION_HOURS=24
REFUGE_CONSTRUCTION_VOTE_HOURS=72
REFUGE_CONSTRUCTION_BUILD_HOURS=168

# ── Refuge — Feu ────────────────────────────────────────────────────
# CSV de secondes, strictement croissant. Vide = seuils non calibrés.
REFUGE_FIRE_LEVEL_THRESHOLDS_SECONDS=
REFUGE_FIRE_INTENSITY_THRESHOLDS_SECONDS=

# ── Refuge — Hall ───────────────────────────────────────────────────
# Les quatre seuils de niveau et les milestones sont des CSV croissants.
# Les IDs historiques sont des IDs d'achievements séparés par des virgules.
REFUGE_HALL_LEVEL_THRESHOLDS_POINTS=
REFUGE_HALL_UNLOCK_WEIGHT=0
REFUGE_HALL_ACHIEVER_WEIGHT=0
REFUGE_HALL_DIVERSITY_WEIGHT=0
REFUGE_HALL_HISTORICAL_FIRST_WEIGHT=0
REFUGE_HALL_RARITY_WEIGHT=0
REFUGE_HALL_HISTORICAL_FIRST_IDS=
REFUGE_HALL_GALLERY_UNLOCK_MILESTONES=
REFUGE_HALL_GALLERY_ACHIEVER_MILESTONES=

# ── YouTube / yt-dlp ────────────────────────────────────────────────
# SECRET — optionnel : base64 d'un cookies.txt Netscape/Mozilla.
YOUTUBE_COOKIES_B64=
# Alternative si le fichier est monté directement dans le conteneur.
YOUTUBE_COOKIES_FILE=
# User-Agent optionnel associé aux cookies exportés.
YOUTUBE_USER_AGENT=

# ── NHL — cog actuellement désactivé dans config.py ─────────────────
# Conservé ici pour que .env.example reste la référence de toutes les variables
# encore consommées par le code si ce cog est réactivé.
NHL_LIVE_CHANNEL_ID=1460631845640208427
NHL_KEY_PLAYERS=
NHL_ODDS_API_URL=
# SECRET — uniquement si le provider de cotes est réactivé.
NHL_ODDS_API_KEY=
NHL_INJURIES_API_URL=