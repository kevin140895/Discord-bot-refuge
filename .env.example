DISCORD_TOKEN=
GUILD_ID=
OWNER_ID=
TZ=Europe/Paris
DATA_DIR=/data
VOICE_CP_DEBOUNCE_SECONDS=2

# YouTube / yt-dlp authentication for hosted environments such as Railway.
# Preferred: base64 of a Netscape/Mozilla cookies.txt file.
YOUTUBE_COOKIES_B64=
# Alternative when the cookies file is mounted directly in the container.
YOUTUBE_COOKIES_FILE=
# Optional: browser User-Agent paired with the exported cookies.
YOUTUBE_USER_AGENT=
